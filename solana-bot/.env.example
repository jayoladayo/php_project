# Copy to .env and fill in. Never commit .env.
# Never put YOUR OWN wallet's private key or seed phrase anywhere: the bot never
# needs it. For automatic trading the bot creates its own wallet (Bot wallet tab).

# --- server
PORT=8787
HOST=127.0.0.1
# Optional: require this token on every mutating API call (set it in the dashboard
# via localStorage.setItem('dashboardToken', '...')). Required if HOST is not local.
DASHBOARD_TOKEN=
# Host names the API answers to (protects against DNS rebinding). Add yours only if you know why.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# --- market data
# live = real data (paper or live trading). mock = offline simulator, paper only.
# State is kept in data/ (live) or data-mock/ (mock) unless DATA_DIR is set.
MARKET_DATA=live
# DATA_DIR=data

# A dedicated RPC (Helius, Triton, QuickNode, ...) is strongly recommended; the
# public endpoint is heavily rate-limited. Keys in the URL are redacted from logs.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com

# Jupiter swap API. lite-api is keyless; with a free key from portal.jup.ag use https://api.jup.ag/swap/v1
JUPITER_API_BASE=https://lite-api.jup.ag/swap/v1
JUPITER_API_KEY=

# RugCheck public report API (LP lock status, holder count, third-party flags)
RUGCHECK_ENABLED=true

# X / Twitter API v2 bearer token (recent search). Optional; without it the
# social section is marked unavailable. Social data never affects buy decisions.
X_BEARER_TOKEN=

# --- notifications (every automatic buy/sell, pauses and errors)
# Telegram: create a bot with @BotFather, send it a message, get your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Slack/Discord-compatible webhook
ALERT_WEBHOOK_URL=

# --- live trading gate
# Live mode cannot be enabled from the dashboard unless this is true. Leave it
# false until you have paper-traded and reviewed the Live mode tab.
LIVE_TRADING_ALLOWED=false

# --- bot wallet (unattended trading)
# Where the encrypted bot wallet is stored (same for practice and real data).
# BOT_WALLET_PATH=data/bot-wallet.json
# OPTIONAL and risky: unlock the bot wallet automatically at startup and resume
# live mode + autopilot after a restart. Anyone who can read this file can then
# use the bot wallet. Leave empty unless the machine is dedicated and secured.
BOT_WALLET_PASSPHRASE=
RESUME_LIVE_AFTER_RESTART=false
