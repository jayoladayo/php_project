# Copy to .env and fill in. Never commit .env. Never put a wallet private key or
# seed phrase anywhere: this bot never needs one (your wallet signs in the browser).

# --- server
PORT=8787
HOST=127.0.0.1
DATA_DIR=data
# Optional: require this token on every mutating API call (set it in the dashboard
# via localStorage.setItem('dashboardToken', '...')). Required if HOST is not local.
DASHBOARD_TOKEN=

# --- market data
# live = real data (paper or live trading). mock = offline simulator, paper only.
MARKET_DATA=live

# A dedicated RPC (Helius, Triton, QuickNode, ...) is strongly recommended; the
# public endpoint is heavily rate-limited. Keys in the URL are redacted from logs.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com

# Jupiter swap API. lite-api is keyless; with a key use https://api.jup.ag/swap/v1
JUPITER_API_BASE=https://lite-api.jup.ag/swap/v1
JUPITER_API_KEY=

# RugCheck public report API (LP lock status, holder count, third-party flags)
RUGCHECK_ENABLED=true

# X / Twitter API v2 bearer token (recent search). Optional; without it the
# social section is marked unavailable. Social data never affects buy decisions.
X_BEARER_TOKEN=

# Optional webhook (Slack/Discord-compatible JSON {text}) for alerts
ALERT_WEBHOOK_URL=

# --- live trading gate
# Live mode cannot be enabled from the dashboard unless this is true. Leave it
# false until you have paper-traded and reviewed the Live mode tab.
LIVE_TRADING_ALLOWED=false
